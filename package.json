{
  "name": "aurum",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch-locale": "node scripts/fetch-enka-locale.js",
    "fetch-weapons": "node scripts/build-weapon-ids.js",
    "fetch-pfps": "node scripts/fetch-profile-pictures.js",
    "fetch-hsr": "node scripts/fetch-hsr-data.js",
    "fetch-hsr-weights": "node scripts/fetch-fribbels-weights.mjs",
    "fetch-hsr-stats": "node scripts/fetch-hsr-stats.mjs",
    "fetch-zzz": "node scripts/fetch-zzz-data.mjs",
    "fetch-zzz-weights": "node scripts/fetch-zzz-weights.mjs",
    "measure-zzz-art": "node scripts/measure-zzz-art.mjs",
    "fetch-genshin-sets": "node scripts/fetch-genshin-sets.mjs",
    "fetch-sets": "node scripts/fetch-prydwen-sets.mjs",
    "fetch-kqm": "node scripts/fetch-kqm-guides.mjs",
    "fetch-game8": "node scripts/fetch-game8-guides.mjs",
    "consensus": "node scripts/consensus.mjs",
    "build-guides": "node scripts/build-genshin-guides.mjs && node scripts/build-hsr-guides.mjs && node scripts/build-zzz-guides.mjs",
    "sync-genshin-tables": "node scripts/sync-genshin-tables.mjs",
    "refresh": "node scripts/refresh.mjs",
    "audit-genshin": "node scripts/audit-genshin-weights.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.8.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
